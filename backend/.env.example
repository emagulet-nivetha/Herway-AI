# ─────────────────────────────────────────────────────────────
# HerWay AI — Backend environment variables
# Copy to `backend/.env` before running the API.
# ─────────────────────────────────────────────────────────────

PORT=5000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5173
CLIENT_URL=http://localhost:5173

# PostgreSQL connection string
DATABASE_URL="postgresql://herway:herway@localhost:5432/herway?schema=public"

# Authentication — replace with a long random string in production
JWT_SECRET="REPLACE_WITH_A_LONG_RANDOM_STRING"
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# Rate limiting
RATE_LIMIT_WINDOW_MIN=15
RATE_LIMIT_MAX_REQUESTS=300

# AI Service Layer — provider can be swapped without code changes
AI_PROVIDER=mock                # mock | openai | anthropic
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
AI_MODEL="gpt-4o-mini"
AI_TIMEOUT_MS=30000

# File uploads
MAX_UPLOAD_MB=5

# Seed admin
SEED_ADMIN_EMAIL="admin@herway.local"
SEED_ADMIN_PASSWORD="HerWay@2026"
