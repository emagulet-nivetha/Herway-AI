# ─────────────────────────────────────────────────────────────
# HerWay AI — Frontend environment variables
# Copy to `frontend/.env` if you want to use the real backend.
#
# Leave VITE_API_URL empty to run the app entirely on the
# built-in mock data layer (recommended for quick demos).
# ─────────────────────────────────────────────────────────────

# Point this at the Express API to use real data.
# Example: VITE_API_URL=http://localhost:5000/api
VITE_API_URL=

# Dev proxy target for /api (used by vite.config.ts)
VITE_API_PROXY=http://localhost:5000
