# ─────────────────────────────────────────────────────────────
# HerWay AI — Environment Variables
# Copy this file to `.env` and fill in real values.
# Never commit the real `.env` file to version control.
# ─────────────────────────────────────────────────────────────

# Server
PORT=5000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5173
CLIENT_URL=http://localhost:5173

# Database (PostgreSQL)
# HerWay runs with an in-memory mock data layer if the DB is
# unreachable, so the app works out of the box with demo data.
DATABASE_URL="postgresql://herway:herway@localhost:5432/herway?schema=public"

# Authentication
JWT_SECRET="REPLACE_WITH_A_LONG_RANDOM_STRING"
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# Rate limiting
RATE_LIMIT_WINDOW_MIN=15
RATE_LIMIT_MAX_REQUESTS=300

# AI Service Layer (abstracted — provider can be swapped)
AI_PROVIDER=mock                # mock | openai | anthropic
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
AI_MODEL="gpt-4o-mini"
AI_TIMEOUT_MS=30000

# File uploads
MAX_UPLOAD_MB=5

# Seed
SEED_ADMIN_EMAIL="admin@herway.local"
SEED_ADMIN_PASSWORD="HerWay@2026"